---
import { siteContent } from '../data/site';
import MaintenanceNotice from '../components/MaintenanceNotice.astro';
import { MAINTENANCE_MODE, maintenanceNotice } from '../../maintenance.config.mjs';

interface Props {
  title?: string;
  description?: string;
  socialDescription?: string;
  ogImage?: string;
  ogImageWidth?: number;
  ogImageHeight?: number;
  withCursor?: boolean;
  fontProfile?: 'landing' | 'press-kit';
}
const {
  title = siteContent.site.defaultTitle,
  description = siteContent.site.defaultDescription,
  socialDescription = description,
  ogImage = siteContent.site.ogImage,
  ogImageWidth = siteContent.site.ogImageWidth,
  ogImageHeight = siteContent.site.ogImageHeight,
  withCursor = false,
  fontProfile = 'landing',
  // Offline, every route renders the same notice, so the page props are
  // dropped: no page-specific title, description or social image reaches the
  // published document. Everything else falls back to the defaults above.
} = MAINTENANCE_MODE
  ? { title: maintenanceNotice.documentTitle, description: maintenanceNotice.description }
  : Astro.props;
const landingFontHref = 'https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600&family=Space+Mono:wght@400;700&display=swap';
const pressKitFontHref = 'https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600&family=Cormorant+Garamond:ital,wght@0,500;0,600;1,500;1,600&family=Hanken+Grotesk:wght@400;500;700&display=swap';
const fontHref = fontProfile === 'press-kit' ? pressKitFontHref : landingFontHref;
const productionBase = Astro.site ?? new URL(siteContent.site.canonicalUrl);
const publicPathname = Astro.url.pathname.replace(/\/index\.html$/, '/').replace(/\.html$/, '');
const canonicalUrl = new URL(publicPathname, productionBase);
const socialImageUrl = new URL(ogImage, productionBase);
---
<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {MAINTENANCE_MODE && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonicalUrl} />

    <link rel="icon" href="/assets/favicon/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href="/assets/favicon/icon-32.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/assets/favicon/icon-192.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/assets/favicon/icon-180.png" />
    <link rel="manifest" href="/assets/favicon/site.webmanifest" />
    <meta name="theme-color" content="#0E0B0A" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteContent.identity.stageName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={socialDescription} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={socialImageUrl} />
    <meta property="og:image:width" content={ogImageWidth} />
    <meta property="og:image:height" content={ogImageHeight} />
    <meta property="og:locale" content="pt_BR" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={socialDescription} />
    <meta name="twitter:image" content={socialImageUrl} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href={fontHref}
      rel="stylesheet"
    />

    {!MAINTENANCE_MODE && <slot name="head" />}
  </head>
  <body>
    {MAINTENANCE_MODE ? <MaintenanceNotice /> : <slot />}
  </body>
</html>
