---
import MaintenanceNotice from '../components/MaintenanceNotice.astro';
import { MAINTENANCE_MODE, maintenanceNotice } from '../../maintenance.config.mjs';

interface Props {
  title: string;
}
// Offline, the print sheets serve the same notice as every other route.
const { title } = MAINTENANCE_MODE
  ? { title: maintenanceNotice.documentTitle }
  : Astro.props;
import '../styles/print.css';
const publicPathname = Astro.url.pathname.replace(/\/index\.html$/, '/').replace(/\.html$/, '');
const canonicalUrl = new URL(publicPathname, Astro.site ?? Astro.url.origin);
---
<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {MAINTENANCE_MODE && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" href="/assets/favicon/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href="/assets/favicon/icon-32.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/assets/favicon/icon-180.png" />
    <meta name="theme-color" content="#0E0B0A" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600&family=Cormorant+Garamond:ital,wght@0,500;0,600;1,500;1,600&family=Hanken+Grotesk:wght@400;500;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    {MAINTENANCE_MODE ? <MaintenanceNotice /> : <slot />}
  </body>
</html>
